<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="synccraft"
        Arguments=""
        InstallLocation="C:\Program Files\SyncCraft\SyncCraft">
    </Installer>
    <PackageInformation
        PackageName="SyncCraft"
        PackageDisplayName="SyncCraft"
        PublisherName="CN=SyncCraft"
        PublisherDisplayName="SyncCraft"
        Version="0.1.0.0"
        PackageDescription="Database schema & data compare tool">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.synccraft.app"
                Description="Database schema & data compare tool"
                DisplayName="SyncCraft"
                ExecutableName="synccraft"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>SyncCraft</DisplayName>
            <PublisherDisplayName>SyncCraft</PublisherDisplayName>
            <Description>Database schema & data compare tool</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="synccraft.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
